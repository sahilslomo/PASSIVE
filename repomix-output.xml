export type PersonaType =
    | "mentor"
    | "examiner"
    | "chiefEngineer"
    | "surveyor"
    | "revisionCoach";

type DetectPersonaInput = {
    message: string;
};

const PERSONA_KEYWORDS = {

    examiner: [
        "oral",
        "viva",
        "mmd",
